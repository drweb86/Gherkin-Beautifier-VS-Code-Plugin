{
	"compilerOptions": {
		"module": "commonjs",
		"target": "es2022",
		"esModuleInterop": true,
		"lib": [
			"ES2022"
		],
		"types": [
			"node"
		],
		"outDir": "out",
		"sourceMap": true,
		"strict": true,
		"rootDir": "src",
		"resolveJsonModule": true,
	},
	"exclude": [
		"node_modules",
		".vscode-test"
	],
}